# ---- App ----
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ---- Database ----
# Local dev: mongodb://127.0.0.1:27017/eventnest
# Production: MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/eventnest

# ---- Auth / JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_random_64_byte_hex
JWT_REFRESH_SECRET=replace_me_with_a_different_random_64_byte_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Cookies ----
COOKIE_SECURE=false
# set COOKIE_SECURE=true in production (HTTPS only)

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
